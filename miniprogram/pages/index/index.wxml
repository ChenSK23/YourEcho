<!--index.wxml 角色列表-->
<view class="page">
  <view class="header">
    <view class="title">有个回音</view>
    <view class="subtitle">你说的话，TA 的语气替你回答</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <view wx:elif="{{profiles.length === 0}}" class="empty">
    <view class="empty-title">这里还很安静</view>
    <view class="empty-desc">导入一段聊天记录，让 TA 的话有个回音</view>
  </view>

  <view class="list" wx:else>
    <view
      wx:for="{{profiles}}"
      wx:key="_id"
      class="card"
      data-id="{{item._id}}"
      data-name="{{item.name}}"
      bindtap="goChat"
      bindlongpress="onLongPress"
    >
      <image
        wx:if="{{item.avatarFileID}}"
        class="card-avatar"
        src="{{item.avatarFileID}}"
        mode="aspectFill"
      />
      <view wx:else class="card-avatar card-avatar--placeholder">{{item.initial}}</view>
      <view class="card-body">
        <view class="card-name">{{item.name}}</view>
        <view class="card-relation">{{item.relation || '朋友'}}</view>
      </view>
      <view class="card-arrow">›</view>
    </view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="goCreate">＋ 召唤一个回音</button>
    <view class="footer-link" bindtap="goPrivacy">隐私政策</view>
  </view>
</view>
